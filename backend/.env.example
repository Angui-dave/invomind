APP_NAME=InvoMind
APP_ENV=local
APP_KEY=
# Production: APP_DEBUG=false
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Production: LOG_LEVEL=warning
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=invomind
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Production: SESSION_ENCRYPT=true and SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Laravel Reverb (websockets) — run: php artisan reverb:start
REVERB_APP_ID=invomind
REVERB_APP_KEY=invomind-key
REVERB_APP_SECRET=invomind-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Messagerie omnicanale
MESSAGERIE_TIKTOK_ENABLED=false
MESSAGERIE_RATE_WHATSAPP=60
MESSAGERIE_RATE_MESSENGER=60
MESSAGERIE_RATE_INSTAGRAM=60
MESSAGERIE_RATE_TIKTOK=20
META_GRAPH_VERSION=v21.0

# Local: log (aucun credential). Production: resend. Fallback: failover (resend puis log).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@invomind.com"
MAIL_FROM_NAME="${APP_NAME}"
# MAIL_MAILER=resend
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- InvoMind ---
FRONTEND_URL=http://localhost:3000
# Origins autorisés pour CORS navigateur (séparés par des virgules)
CORS_ALLOWED_ORIGINS=http://localhost:3000
# SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000

# Meta (WhatsApp / Messenger / Instagram)
META_VERIFY_TOKEN=invomind-verify-2026
META_APP_SECRET=

# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# CinetPay (PSP factures portail + abonnement SaaS plateforme)
CINETPAY_SITE_ID=
CINETPAY_API_KEY=
CINETPAY_SECRET_KEY=
CINETPAY_NOTIFY_URL="${APP_URL}/api/webhooks/cinetpay"
CINETPAY_RETURN_URL="${FRONTEND_URL}/f/{token}?paid=1"
CINETPAY_ENV=sandbox
# true = activate Pro/Business without real CinetPay (local default)
CINETPAY_SIMULATE=true
# Tests only (never in production): PSP_DRIVER=fake
