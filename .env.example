# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Laravel = source de vérité (recommandé)
USE_LARAVEL_API=true
LARAVEL_API_URL=http://localhost:8000/api
# URL publique Laravel pour afficher les webhooks inbound dans Settings (optionnel)
NEXT_PUBLIC_LARAVEL_API_URL=http://localhost:8000/api
LARAVEL_TIMEOUT_MS=10000

# Mocks en mémoire — ignorés si USE_LARAVEL_API=true
NEXT_PUBLIC_USE_MOCK_DATA=false

# Auth (signature du cookie de session Next — min 32 chars en production)
# Générer: openssl rand -base64 48
SESSION_SECRET=dev-session-secret-change-in-production-32chars

# Postgres / Drizzle — LEGACY (non requis en mode Laravel)
# DATABASE_URL=postgresql://invomind_app:invomind_app@localhost:5432/invomind
# DATABASE_URL_OWNER=postgresql://invomind_owner:invomind_owner@localhost:5432/invomind

# Outbound webhook (legacy Next) — configurer plutôt côté Laravel
CONVERSATIONS_WEBHOOK_URL=
CONVERSATIONS_WEBHOOK_SECRET=

# Meta / TikTok secrets : configurer dans backend/.env
# Les routes Next /api/webhooks/* proxifient vers Laravel (sauf CinetPay → Laravel direct).
META_VERIFY_TOKEN=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
