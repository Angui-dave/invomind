# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# true = mocks en mémoire ; false = données réelles
NEXT_PUBLIC_USE_MOCK_DATA=true
# Source de vérité API côté serveur (server actions / DAL)
USE_LARAVEL_API=true
LARAVEL_API_URL=http://localhost:8000/api
LARAVEL_TIMEOUT_MS=10000

# Auth (toujours requis pour signer le cookie de session mock)
SESSION_SECRET=dev-session-secret-change-in-production-32chars

# Postgres — optionnel tant que NEXT_PUBLIC_USE_MOCK_DATA=true
# DATABASE_URL=postgresql://invomind_app:invomind_app@localhost:5432/invomind
# DATABASE_URL_OWNER=postgresql://invomind_owner:invomind_owner@localhost:5432/invomind

# Outbound webhook
CONVERSATIONS_WEBHOOK_URL=
CONVERSATIONS_WEBHOOK_SECRET=

# Meta
META_VERIFY_TOKEN=
META_APP_SECRET=

# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
